# Local dev (SQLite, no setup needed):
# DATABASE_URL=sqlite:///dev.db

# Production (Google Cloud SQL Postgres) — two connection styles:
#
# 1) Via public IP / Cloud SQL Auth Proxy sidecar (what Cloud Run uses when you
#    attach the instance with --add-cloudsql-instances):
# DATABASE_URL=postgresql://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# 2) Via a direct host:port (e.g. Cloud SQL with a public IP, or any other
#    managed Postgres such as Supabase/Neon/RDS):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# CORS — comma-separated list of frontend origins (scheme + host + port,
# no trailing slash) allowed to call this API and the /uploads media route.
# Frontend runs on 6175, backend on 5175.
# Use ALLOWED_ORIGINS=* to allow every origin (handy for LAN/device testing;
# keep it restricted in production). If unset, the three localhost origins
# below are allowed by default.
ALLOWED_ORIGINS=http://localhost:6175,http://localhost:5175,http://localhost:5173,https://your-app.vercel.app
# Optional: how long browsers may cache CORS preflight responses (seconds)
# CORS_MAX_AGE=86400
# Required for signed dashboard sessions
SECRET_KEY=replace-with-a-long-random-secret

FLASK_APP=wsgi.py
FLASK_ENV=production

# Optional local media upload settings for dashboard direct photo/video uploads
# UPLOAD_FOLDER=/absolute/path/to/persistent/uploads
MAX_UPLOAD_MB=100
